@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using AcademyDZ.Models
@inject IDbContextFactory<AcademyDZContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Group</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Groups" OnValidSubmit="AddGroup" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="group_name" class="form-label">group_name:</label> 
                <InputText id="group_name" @bind-Value="Groups.group_name" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Groups.group_name" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="direction" class="form-label">direction:</label> 
                <InputNumber id="direction" @bind-Value="Groups.direction" class="form-control" /> 
                <ValidationMessage For="() => Groups.direction" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="learning_days" class="form-label">learning_days:</label> 
                <InputNumber id="learning_days" @bind-Value="Groups.learning_days" class="form-control" /> 
                <ValidationMessage For="() => Groups.learning_days" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="start_time" class="form-label">start_time:</label> 
                <InputDate id="start_time" @bind-Value="Groups.start_time" class="form-control" /> 
                <ValidationMessage For="() => Groups.start_time" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="start_date" class="form-label">start_date:</label> 
                <InputDate id="start_date" @bind-Value="Groups.start_date" class="form-control" /> 
                <ValidationMessage For="() => Groups.start_date" class="text-danger" /> 
            </div>            
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/groups">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Group Groups { get; set; } = default!;

    protected override void OnInitialized() => Groups ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Groups.Add(Groups);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}
